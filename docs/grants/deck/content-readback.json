        {
          "id": "p1_i4",
          "type": "shape",
          "text": "Built on Arc testnet"
        },
        {
          "id": "p1_i5",
          "type": "shape",
          "text": "A fixed USDC claim, funded reserves and a choice of exits."
        },
        {
          "id": "p1_i6",
          "type": "shape",
          "text": "Circle USDC powers the claim, reserve and gas"
        },
        {
          "id": "p1_i7",
          "type": "shape",
          "text": "arc.yieldshield.ai"
        },
        {
          "id": "p1_i8",
          "type": "shape",
          "text": "$16,000"
        },
        {
          "id": "p1_i9",
          "type": "shape",
          "text": "Grant request\n\n$11,000 core work\n$5,000 conditional\nmainnet release"
        },
        {
          "id": "p1_i10",
