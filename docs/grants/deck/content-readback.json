    },
    {
      "id": "p2",
      "elements": [
        {
          "id": "p2_i12",
          "type": "shape",
          "text": "YIELDSHIELD ARC"
        },
        {
          "id": "p2_i2",
          "type": "shape"
        },
        {
          "id": "p2_i3",
          "type": "shape",
          "text": "A choice for holders, a risk for providers"
        },
        {
          "id": "p2_i4",
          "type": "shape",
          "text": "Asset holders"
        },
        {
          "id": "p2_i5",
          "type": "shape",
          "text": "Keep EUR or BTC exposure while setting a fixed exit value in USDC.\n\nConventional hedges can need active pricing and specialist execution."
        },
        {
          "id": "p2_i6",
          "type": "shape",
          "text": "Capital providers"
        },
        {
          "id": "p2_i7",
          "type": "shape",
          "text": "Commit USDC reserves to earn fees on realized gains.\n\nReceive the surrendered asset and bear its downside risk."
        },
        {
          "id": "p2_i8",
          "type": "shape",
          "text": "First audience"
        },
        {
          "id": "p2_i9",
          "type": "shape",
          "text": "Arc treasury, lending, wallet and agent builders in a controlled testnet pilot."
        },
        {
          "id": "p2_i10",
          "type": "shape",
          "text": "Arc testnet. Unaudited. Test tokens have no monetary value."
        },
        {
          "id": "p2_i11",
          "type": "shape",
          "text": "02"
        }
      ]
    },
    {
      "id": "p3",
      "elements": [
        {
          "id": "p3_i12",
          "type": "shape",
          "text": "YIELDSHIELD ARC"
        },
        {
          "id": "p3_i2",
          "type": "shape"
        },
        {
          "id": "p3_i3",
          "type": "shape",
          "text": "The protection lifecycle"
        },
        {
          "id": "p3_i4",
          "type": "shape",
          "text": "At entry"
        },
        {
          "id": "p3_i5",
          "type": "shape",
          "text": "The oracle fixes the USDC claim. Providers reserve 150% of that amount."
        },
        {
          "id": "p3_i6",
          "type": "shape",
          "text": "Keep the asset"
        },
        {
          "id": "p3_i7",
          "type": "shape",
          "text": "Pay 12% of realized gain only.\n10% goes to providers, 1% to the creator and 1% to the protocol."
        },
        {
          "id": "p3_i8",
          "type": "shape",
          "text": "Take the USDC claim"
        },
        {
          "id": "p3_i9",
          "type": "shape",
          "text": "Surrender the asset for the fixed claim.\nProviders receive the asset and bear its loss."
        },
        {
          "id": "p3_i10",
          "type": "shape",
          "text": "Arc testnet. Unaudited. Test tokens have no monetary value."
        },
        {
          "id": "p3_i11",
          "type": "shape",
          "text": "03"
        },
        {
          "id": "arc_maturity_note",
          "type": "shape",
          "text": "At maturity, anyone may settle. Remaining assets go to providers and holders claim USDC."
        }
      ]
